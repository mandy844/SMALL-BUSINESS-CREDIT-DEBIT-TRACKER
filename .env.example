# ============================================================
# Duka Ledger — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Session secret — MUST be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_long_random_string_here

# SQLite database path (relative to project root or absolute)
DB_PATH=./data/duka.db

# BCrypt work factor (10–14 recommended; higher = slower)
BCRYPT_ROUNDS=12

# Timezone used for "today's" date in reports (IANA timezone string)
SHOP_TZ=Africa/Nairobi
